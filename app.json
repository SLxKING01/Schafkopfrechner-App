{
  "expo": {
    "name": "Schafkopfrechner-App",
    "slug": "Schafkopfrechner-App",
    "version": "1.0.0",
    "scheme": "schafkopfrechner",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.simon.schafkopfrechnerapp",
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.anonymous.SchafkopfrechnerApp"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      [
        "expo-widgets",
        {
          "widgets": [
            {
              "name": "QuickRound",
              "displayName": "Spiel eintragen",
              "description": "Öffnet die Spieleingabe am laufenden Tisch.",
              "ios": {
                "supportedFamilies": ["accessoryRectangular"]
              },
              "android": null
            }
          ]
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#07110B"
        }
      ],
      "expo-image",
      [
        "expo-image-picker",
        {
          "photosPermission": "Wähle ein Foto für dein Profil aus. Andere Profilangaben bleiben auch ohne Foto nutzbar.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "d5150b0f-cf7d-41cf-b1ad-67c03e5c82d1"
      }
    }
  }
}
